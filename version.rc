1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     4,0,0,0
PRODUCTVERSION  4,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Neofilisoft"
            VALUE "FileDescription",  "FeReader PDF EPUB Viewer"
            VALUE "FileVersion",      "4.0.0.0"
            VALUE "ProductVersion",   "4.0.0"
            VALUE "ProductName",      "FeReader"
            VALUE "InternalName",     "FeReader"
            VALUE "OriginalFilename", "FeReader.exe"
            VALUE "LegalCopyright",   "Copyright 2026 Neofilisoft"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
